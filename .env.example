# Copy to .env and edit. .env is git-ignored.
# Bearer token for the MCP endpoint (/mcp/). Generate e.g.: python -c "import secrets;print(secrets.token_urlsafe(32))"
CREWBOARD_MCP_TOKEN=change-me
# Data directory (SQLite DB, uploaded avatars, optional rules.md override). Relative to the repo root.
CREWBOARD_DATA_DIR=data
CREWBOARD_HOST=127.0.0.1
CREWBOARD_PORT=8090
# Public sub-path when served behind a reverse proxy that strips the prefix (e.g. /crewboard). Empty for root.
CREWBOARD_BASE_PATH=
